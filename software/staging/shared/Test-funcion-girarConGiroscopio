#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BNO055.h>

// ---- SELECCIÓN DE ROBOT ----
//#define ROBOT1   // Arquero
#define ROBOT2     // Delantero

// ---- PINES DE MOTORES ----
#if defined(ROBOT2)
  #define INA1 8
  #define INB1 7
  #define PWM1 6
  #define INA2 11
  #define INB2 12
  #define PWM2 4
  #define INA3 2
  #define INB3 5
  #define PWM3 3
#endif

#if defined(ROBOT1)
  #define INA1 2
  #define INB1 5
  #define PWM1 3
  #define INA2 8
  #define INB2 7
  #define PWM2 6
  #define INA3 11
  #define INB3 12
  #define PWM3 4
#endif

// ---- GIROSCOPIO ----
Adafruit_BNO055 bno = Adafruit_BNO055(55, 0x28);
float initialYaw = 0;
float currentYaw = 0;

const float TOLERANCIA_GIRO = 3.0; // grados

// ============================================================
//  girarConGiroscopio()
// ============================================================
bool girarConGiroscopio(float currentYaw, float initialYaw, float anguloObjetivo, float velocidad) {

  float errorGiro = (currentYaw - initialYaw) - anguloObjetivo;

  if (errorGiro >  180) errorGiro -= 360;
  if (errorGiro < -180) errorGiro += 360;

  if (abs(errorGiro) <= TOLERANCIA_GIRO) {
    analogWrite(PWM1, 0); digitalWrite(INA1, LOW); digitalWrite(INB1, LOW);
    analogWrite(PWM2, 0); digitalWrite(INA2, LOW); digitalWrite(INB2, LOW);
    analogWrite(PWM3, 0); digitalWrite(INA3, LOW); digitalWrite(INB3, LOW);
    return true;
  }

  int pwm = constrain((int)(velocidad * 255), 0, 255);

  if (errorGiro > 0) {
    analogWrite(PWM1, pwm); digitalWrite(INA1, LOW);  digitalWrite(INB1, HIGH);
    analogWrite(PWM2, pwm); digitalWrite(INA2, LOW);  digitalWrite(INB2, HIGH);
    analogWrite(PWM3, pwm); digitalWrite(INA3, LOW);  digitalWrite(INB3, HIGH);
  } else {
    analogWrite(PWM1, pwm); digitalWrite(INA1, HIGH); digitalWrite(INB1, LOW);
    analogWrite(PWM2, pwm); digitalWrite(INA2, HIGH); digitalWrite(INB2, LOW);
    analogWrite(PWM3, pwm); digitalWrite(INA3, HIGH); digitalWrite(INB3, LOW);
  }

  return false;
}

// ============================================================
//  MÁQUINA DE ESTADOS DEL TEST
// ============================================================
enum EstadoTest {
  GIRAR_90,       // girar a 90° y quedarse
  ESPERAR_90,     // esperar 10 segundos en 90°
  GIRAR_0,        // girar a 0°
  ESPERAR_0,      // esperar 10 segundos en 0°
  GIRAR_MENOS45,  // girar a -45°
  ESPERAR_MENOS45,// esperar 5 segundos en -45°
  GIRAR_180,      // girar a 180°
  ESPERAR_180,    // esperar 5 segundos en 180°
  GIRAR_FINAL_0,  // girar a 0° y quedarse
  FIN
};

EstadoTest estado = GIRAR_90;
unsigned long tiempoEspera = 0;

// ============================================================
//  SETUP
// ============================================================
void setup() {
  pinMode(INA1, OUTPUT); pinMode(INB1, OUTPUT); pinMode(PWM1, OUTPUT);
  pinMode(INA2, OUTPUT); pinMode(INB2, OUTPUT); pinMode(PWM2, OUTPUT);
  pinMode(INA3, OUTPUT); pinMode(INB3, OUTPUT); pinMode(PWM3, OUTPUT);

  Serial.begin(19200);

  if (!bno.begin()) {
    Serial.println("ERROR: No se encontró el BNO055!");
    while (1);
  }
  bno.setExtCrystalUse(true);

  sensors_event_t event;
  bno.getEvent(&event);
  initialYaw = event.orientation.x;

  Serial.print("Yaw inicial: ");
  Serial.println(initialYaw);
}

// ============================================================
//  LOOP
// ============================================================
void loop() {

  // Lectura del BNO055 — una sola vez por ciclo
  sensors_event_t event;
  bno.getEvent(&event);
  currentYaw = event.orientation.x;

  switch (estado) {

    case GIRAR_90:
      if (girarConGiroscopio(currentYaw, initialYaw, 90.0, 0.4)) {
        tiempoEspera = millis();
        estado = ESPERAR_90;
        Serial.println("Llegó a 90° — esperando 10s");
      }
      break;

    case ESPERAR_90:
      // Mantener el ángulo mientras espera
      girarConGiroscopio(currentYaw, initialYaw, 90.0, 0.4);
      if (millis() - tiempoEspera >= 10000) {
        estado = GIRAR_0;
        Serial.println("Yendo a 0°");
      }
      break;

    case GIRAR_0:
      if (girarConGiroscopio(currentYaw, initialYaw, 0.0, 0.4)) {
        tiempoEspera = millis();
        estado = ESPERAR_0;
        Serial.println("Llegó a 0° — esperando 10s");
      }
      break;

    case ESPERAR_0:
      girarConGiroscopio(currentYaw, initialYaw, 0.0, 0.4);
      if (millis() - tiempoEspera >= 10000) {
        estado = GIRAR_MENOS45;
        Serial.println("Yendo a -45°");
      }
      break;

    case GIRAR_MENOS45:
      if (girarConGiroscopio(currentYaw, initialYaw, -45.0, 0.4)) {
        tiempoEspera = millis();
        estado = ESPERAR_MENOS45;
        Serial.println("Llegó a -45° — esperando 5s");
      }
      break;

    case ESPERAR_MENOS45:
      girarConGiroscopio(currentYaw, initialYaw, -45.0, 0.4);
      if (millis() - tiempoEspera >= 5000) {
        estado = GIRAR_180;
        Serial.println("Yendo a 180°");
      }
      break;

    case GIRAR_180:
      if (girarConGiroscopio(currentYaw, initialYaw, 180.0, 0.4)) {
        tiempoEspera = millis();
        estado = ESPERAR_180;
        Serial.println("Llegó a 180° — esperando 5s");
      }
      break;

    case ESPERAR_180:
      girarConGiroscopio(currentYaw, initialYaw, 180.0, 0.4);
      if (millis() - tiempoEspera >= 5000) {
        estado = GIRAR_FINAL_0;
        Serial.println("Yendo a 0° final");
      }
      break;

    case GIRAR_FINAL_0:
      if (girarConGiroscopio(currentYaw, initialYaw, 0.0, 0.4)) {
        estado = FIN;
        Serial.println("Test completo — robot en 0°");
      }
      break;

    case FIN:
      // No hace nada, queda en 0°
      break;
  }
}
